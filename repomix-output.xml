CREATE OR REPLACE FUNCTION public.businesses_auto_disable()
RETURNS TRIGGER LANGUAGE plpgsql SECURITY INVOKER SET search_path = public AS $$
BEGIN
  IF NEW.tax_expires_at IS NOT NULL AND NEW.tax_expires_at < now() THEN
    NEW.enabled := false;
  END IF;
  NEW.updated_at := now();
  RETURN NEW;
END;
$$;

