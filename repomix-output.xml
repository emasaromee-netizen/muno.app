                  );
                })}
              </tbody>
            </table>
          </div>

          {/* Vista Móvil */}
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 lg:hidden">
            {items.map((r) => {
              const Icon = r.status === "Cerrado" ? CheckCircle2 : r.status === "En curso" ? Clock : AlertCircle;
              const short = r.id.slice(0, 4).toUpperCase();
