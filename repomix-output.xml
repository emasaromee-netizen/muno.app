            {AGES.map((a) => (
              <button key={a} onClick={() => setAge(a)} className={`px-4 py-2 rounded-[20px] text-sm font-bold whitespace-nowrap ${age === a ? "bg-muno-teal text-white" : "bg-card border"}`}>{a}</button>
            ))}
