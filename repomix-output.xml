          supabase.from("businesses").select("id", { count: "exact", head: true })
            .eq("municipality_id", muniId).eq("enabled", false),
          supabase.from("content_items").select("id", { count: "exact", head: true })
            .eq("municipality_id", muniId).eq("kind", "Evento")
