      return () => { isMounted = false; };
  }, []);

  // SOLUCIÓN M-03: Carga paralela de KPIs
  useEffect(() => {
    let isMounted = true;
    if (!user?.id) return;

    const fetchRealCounts = async () => {
      try {
        const { data: profile } = await supabase
          .from("profiles")
          .select("municipality_id")
          .eq("id", user.id)
